# Copy to .env and fill in. Names only here — never commit real values.

# --- HTTP ---
PORT=8080

# --- LLM provider (mandatory: operator notes are interpreted by the model) ---
# groq | openai | openai_compatible
LLM_PROVIDER=groq

# Groq (default provider).
# Accepts one key, or several comma-separated. Requests round-robin across the pool and a
# rate-limited key is skipped until its Retry-After elapses, so N free-tier keys give roughly
# N times the per-minute token budget. No spaces needed; blanks are ignored.
#   GROQ_API_KEY=gsk_one,gsk_two,gsk_three
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI (LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Any other OpenAI-compatible endpoint (LLM_PROVIDER=openai_compatible)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Per-attempt provider timeout and the bounded retry budget
LLM_TIMEOUT_MS=9000
LLM_MAX_ATTEMPTS=2

# --- Optional: MongoDB Atlas run history. Unset = feature off, API unaffected. ---
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=gridwise
