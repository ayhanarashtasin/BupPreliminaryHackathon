    "test": "node --test test/*.test.js",
    "samples": "node --env-file-if-exists=.env scripts/run-public-samples.js",
    "benchmark": "node --env-file-if-exists=.env scripts/benchmark.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "glpk.js": "^4.0.2",
    "mongodb": "^6.21.0"
  }
}
