{
  "name": "gridwise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GridWise \u2014 LLM-assisted smart campus 24h energy optimization API (BUP CSE Fest 2026 preliminary)",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
